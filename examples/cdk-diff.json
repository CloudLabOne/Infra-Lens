{
  "stacks": {
    "ApiStack": {
      "create": true,
      "resources": {
        "ApiGateway": {
          "type": "AWS::ApiGateway::RestApi",
          "create": true
        },
        "ApiGateway/DefaultStage": {
          "type": "AWS::ApiGateway::Stage",
          "create": true
        },
        "OrdersFunction": {
          "type": "AWS::Lambda::Function",
          "create": true
        },
        "OrdersFunction/ServiceRole": {
          "type": "AWS::IAM::Role",
          "create": true
        },
        "OrdersFunction/ServiceRole/DefaultPolicy": {
          "type": "AWS::IAM::Policy",
          "create": true
        },
        "OrdersTable": {
          "type": "AWS::DynamoDB::Table",
          "create": true
        }
      }
    },
    "LegacyStack": {
      "resources": {
        "OldQueue": {
          "type": "AWS::SQS::Queue",
          "destroy": true
        },
        "OldQueuePolicy": {
          "type": "AWS::SQS::QueuePolicy",
          "destroy": true
        },
        "LegacyBucket": {
          "type": "AWS::S3::Bucket",
          "replace": true
        }
      }
    }
  }
}
